{
  "name": "exeriva",
  "version": "0.0.1",
  "private": true,
  "description": "This tool allows the students to practice the exercises while allows the teachers to create and manage the exercises.",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "Suresh Kumar Gadi <gadisureshkumar@gmail.com>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "dev-pwa": "quasar dev -m pwa",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.43.11",
    "@quasar/extras": "^2.0.4",
    "@quasar/quasar-ui-qmarkdown": "^4.2.1",
    "@rod2ik/tikzjax": "1.6.0",
    "codemirror": "^6.0.2",
    "katex": "^0.18.7",
    "mathjs": "^15.2.0",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "quasar": "^2.29.0",
    "vue": "^3.5.22",
    "vue-codemirror": "^6.1.1",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@quasar/app-vite": "^3.8.1",
    "@quasar/quasar-app-extension-qmarkdown": "^4.2.1",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "Exeriva"
}
